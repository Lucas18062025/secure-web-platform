# secure-web-platform — variables de entorno
# Copiar como .env en la raíz o exportar según capa:
#   Frontend (Cloudflare Workers): NEXT_PUBLIC_API
#   Backend (uvicorn local): DATABASE_URL

# URL base del API FastAPI (dev local)
NEXT_PUBLIC_API=http://localhost:8000

# PostgreSQL (persistencia objetivo; ver database/README.md)
DATABASE_URL=postgresql://secureweb:secureweb@localhost:5432/secureweb

# Puerto del backend en dev
API_PORT=8000
